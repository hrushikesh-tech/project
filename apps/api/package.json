{
  "name": "@amdox/api",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "nest start --watch",
    "build": "nest build",
    "start": "nest start",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test:unit:raw": "node --test --test-isolation=none test/unit/*.test.mjs",
    "test:unit:coverage:raw": "node --experimental-test-coverage --test-coverage-lines=80 --test --test-isolation=none --test-coverage-include=dist/src/ap-ar/ap-ar.service.js --test-coverage-include=dist/src/ap-ar/matching/three-way-match.service.js --test-coverage-include=dist/src/ap-ar/reports/aging-report.service.js --test-coverage-include=dist/src/finance/finance.service.js --test-coverage-include=dist/src/finance/fx-rates.service.js --test-coverage-include=dist/src/hr/hr.service.js --test-coverage-include=dist/src/forecasting/forecasting.service.js --test-coverage-include=dist/src/payroll/engine/india-tax.service.js --test-coverage-include=dist/src/payroll/engine/payroll-engine.service.js --test-coverage-include=dist/src/payroll/payroll.service.js --test-coverage-include=dist/src/supply-chain/supply-chain.service.js --test-coverage-include=dist/src/supply-chain/inventory/fifo-inventory.service.js --test-coverage-include=dist/src/supply-chain/receiving/goods-receipt.service.js --test-coverage-include=dist/src/supply-chain/reorder/reorder-automation.service.js --test-coverage-include=dist/src/project-management/project-management.service.js --test-coverage-include=dist/src/project-management/project-dependency.service.js --test-coverage-include=dist/src/project-management/project-budget-alert.service.js --test-coverage-include=dist/src/bi/metrics/bi-metrics.service.js --test-coverage-include=dist/src/bi/bi-refresh.service.js --test-coverage-include=dist/src/notifications/notification-delivery.service.js --test-coverage-include=dist/src/notifications/notifications.service.js --test-coverage-include=dist/src/notifications/outbox-poller.service.js test/unit/*.test.mjs test/integration/*.test.mjs",
    "test:integration:raw": "node --test --test-isolation=none test/integration/*.test.mjs",
    "test:unit": "pnpm run build && pnpm run test:unit:raw",
    "test:unit:coverage": "pnpm run build && pnpm run test:unit:coverage:raw",
    "test:integration": "pnpm run build && pnpm run test:integration:raw",
    "test:smoke": "pnpm run build && node test/smoke/auth-runtime.smoke.mjs",
    "test:finance": "pnpm run build && pnpm run test:unit:raw && pnpm run test:integration:raw",
    "test:payroll:perf": "node test/perf/payroll.batch.perf.mjs"
  },
  "dependencies": {
    "@amdox/db": "workspace:^",
    "@amdox/types": "workspace:^",
    "@apollo/server": "^5.0.0",
    "@as-integrations/express5": "^1.1.2",
    "@aws-sdk/client-s3": "^3.1030.0",
    "@aws-sdk/client-textract": "^3.1030.0",
    "@napi-rs/canvas": "^0.1.98",
    "@nestjs/apollo": "^13.0.0",
    "@nestjs/bullmq": "^11.0.4",
    "@nestjs/common": "^11.1.18",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.1.18",
    "@nestjs/graphql": "^13.0.0",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.1.18",
    "@nestjs/schedule": "^6.1.1",
    "@nestjs/swagger": "^11.2.0",
    "@nestjs/throttler": "^6.4.0",
    "@nestjs/terminus": "^11.1.1",
    "bullmq": "^5.74.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "dataloader": "^2.2.3",
    "file-type": "^21.3.4",
    "graphql": "^16.11.0",
    "graphql-depth-limit": "^1.1.0",
    "graphql-query-complexity": "^1.1.0",
    "helmet": "^8.1.0",
    "ioredis": "^5.10.1",
    "jwks-rsa": "^4.0.1",
    "nestjs-cls": "^6.2.0",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pdfjs-dist": "^5.6.205",
    "puppeteer": "^24.41.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "sharp": "^0.34.5",
    "tesseract.js": "^6.0.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.19",
    "@nestjs/schematics": "^11.0.10",
    "@nestjs/testing": "11.1.18",
    "@swc/cli": "^0.8.1",
    "@swc/core": "^1.15.24",
    "@types/node": "^25.5.2",
    "@types/passport-jwt": "^4.0.1",
    "axios": "^1.15.0",
    "supertest": "^7.2.2",
    "ts-morph": "^28.0.0",
    "typescript": "^6.0.2"
  }
}
