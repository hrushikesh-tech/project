{
  "name": "@amdox/api",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "nest start --watch",
    "build": "nest build",
    "start": "node dist/src/main.js",
    "start:prod": "node dist/src/main.js",
    "worker": "node dist/src/worker.js",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test:unit:raw": "node --test --test-isolation=none test/unit/*.test.mjs",
    "test:integration:raw": "node --test --test-isolation=none test/integration/*.test.mjs",
    "test:unit": "pnpm run build && pnpm run test:unit:raw",
    "test:integration": "pnpm run build && pnpm run test:integration:raw",
    "test:finance": "pnpm run build && pnpm run test:unit:raw && pnpm run test:integration:raw",
    "test:payroll:perf": "node test/perf/payroll.batch.perf.mjs"
  },
  "dependencies": {
    "@amdox/db": "workspace:^",
    "@amdox/types": "workspace:^",
    "@aws-sdk/client-s3": "^3.1030.0",
    "@aws-sdk/client-textract": "^3.1030.0",
    "@napi-rs/canvas": "^0.1.98",
    "@nestjs/bullmq": "^11.0.4",
    "@nestjs/common": "^11.1.18",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.1.18",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.1.18",
    "@nestjs/schedule": "^6.1.1",
    "@nestjs/terminus": "^11.1.1",
    "bullmq": "^5.74.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "file-type": "^21.3.4",
    "ioredis": "^5.10.1",
    "jwks-rsa": "^4.0.1",
    "nestjs-cls": "^6.2.0",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pdfjs-dist": "^5.6.205",
    "puppeteer": "^24.41.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "sharp": "^0.34.5",
    "tesseract.js": "^6.0.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.19",
    "@nestjs/schematics": "^11.0.10",
    "@nestjs/testing": "^11.1.19",
    "@swc/cli": "^0.8.1",
    "@swc/core": "^1.15.24",
    "@types/node": "^25.5.2",
    "@types/passport-jwt": "^4.0.1",
    "axios": "^1.15.0",
    "supertest": "^7.2.2",
    "typescript": "^6.0.2"
  }
}
