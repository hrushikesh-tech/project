// =============================================================================
// Amdox Technologies — AI-Powered Cloud ERP Suite
// Prisma Schema — Complete Data Model
// =============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// =============================================================================
// Section 1 — Enums (Stable Values — D-03 Hybrid Strategy)
// =============================================================================

enum AccountType {
  ASSET
  LIABILITY
  EQUITY
  REVENUE
  EXPENSE
}

enum JournalEntryStatus {
  DRAFT
  POSTED
  REVERSED
}

enum NotificationChannel {
  IN_APP
  EMAIL
  SMS
  WEBHOOK
}

enum WidgetType {
  BAR_CHART
  LINE_CHART
  PIE_CHART
  KPI_CARD
  TABLE
  HEATMAP
  FUNNEL
}

enum UserSessionStatus {
  ACTIVE
  REVOKED
  EXPIRED
}

enum GdprRequestKind {
  EXPORT
  ERASURE
}

enum GdprRequestStatus {
  REQUESTED
  PROCESSING
  EXPORT_READY
  PSEUDONYMIZED
  FAILED
}

// =============================================================================
// Section 2 — Core / System Models
// =============================================================================

model Tenant {
  id        String    @id @default(cuid())
  name      String
  slug      String    @unique
  domain    String?
  status    String    @default("ACTIVE")
  settings  Json?
  plan      String    @default("STANDARD")
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  // Relations
  users       User[]
  departments Department[]
  legalEntities LegalEntity[]
  accounts      Account[]
  fiscalPeriods FiscalPeriod[]
  journalEntries JournalEntry[]
  journalLines   JournalLine[]
  intercompanyTransfers IntercompanyTransfer[]
}

model User {
  id          String    @id @default(cuid())
  email       String
  firstName   String
  lastName    String
  keycloakId  String    @unique
  tenantId    String
  role        String    @default("viewer")
  isActive    Boolean   @default(true)
  lastLoginAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  // Relations
  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  notifications Notification[]
  dashboards    Dashboard[]

  @@unique([tenantId, email])
  @@index([tenantId])
  @@index([keycloakId])
}

model UserSession {
  id                String            @id @default(cuid())
  tenantId          String
  userId            String
  keycloakSessionId String
  refreshTokenHash  String
  status            UserSessionStatus @default(ACTIVE)
  issuedAt          DateTime
  lastUsedAt        DateTime?
  expiresAt         DateTime
  revokedAt         DateTime?
  revocationReason  String?
  ipAddress         String?
  userAgent         String?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  deletedAt         DateTime?

  @@unique([tenantId, userId, keycloakSessionId])
  @@index([tenantId, userId, status])
  @@index([tenantId, keycloakSessionId])
  @@index([expiresAt])
}

model AuditLog {
  id         String   @id @default(cuid())
  timestamp  DateTime @default(now())
  action     String
  entityType String
  entityId   String
  before     Json?
  after      Json?
  userId     String
  tenantId   String
  ipAddress  String?
  userAgent  String?
  metadata   Json?

  @@index([tenantId, timestamp])
  @@index([entityType, entityId])
  @@index([userId])
}

model GdprRequest {
  id                  String            @id @default(cuid())
  tenantId            String
  subjectUserId       String
  requestedByUserId   String?
  kind                GdprRequestKind
  status              GdprRequestStatus  @default(REQUESTED)
  traceId             String            @unique
  processingStartedAt DateTime?
  completedAt         DateTime?
  failureReason       String?
  artifactMetadata    Json?
  retentionNotes      Json?
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
  deletedAt           DateTime?

  @@index([tenantId, subjectUserId])
  @@index([tenantId, kind, status])
  @@index([tenantId, requestedByUserId])
  @@index([traceId])
}

// =============================================================================
// Section 3 — Finance Models
// =============================================================================

model LegalEntity {
  id           String    @id @default(cuid())
  code         String
  name         String
  baseCurrency String    @default("INR")
  isActive     Boolean   @default(true)
  tenantId     String
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  tenant              Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  accounts            Account[]
  fiscalPeriods       FiscalPeriod[]
  journalEntries      JournalEntry[]
  vendors             Vendor[]
  customers           Customer[]
  invoices            Invoice[]
  purchaseOrders      PurchaseOrder[]
  goodsReceipts       GoodsReceipt[]
  replenishmentSettings ProductReplenishmentSetting[]
  inventoryMovements  InventoryMovement[]
  salaryStructures    SalaryStructure[]
  payrollRuns         PayrollRun[]
  outgoingTransfers   IntercompanyTransfer[] @relation("IntercompanyFromEntity")
  incomingTransfers   IntercompanyTransfer[] @relation("IntercompanyToEntity")

  @@unique([tenantId, code])
  @@index([tenantId])
}

model Account {
  id        String      @id @default(cuid())
  code      String
  name      String
  type      AccountType
  parentId  String?
  legalEntityId String
  isActive  Boolean     @default(true)
  currency  String      @default("INR")
  tenantId  String
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  deletedAt DateTime?

  // Self-relation for Chart of Accounts hierarchy
  parent   Account?  @relation("AccountHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children Account[] @relation("AccountHierarchy")

  // Relations
  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  legalEntity  LegalEntity   @relation(fields: [legalEntityId], references: [id], onDelete: Cascade)
  journalLines JournalLine[]
  vendorPayablesConfigurations Vendor[]   @relation("VendorPayablesAccount")
  customerReceivablesConfigurations Customer[] @relation("CustomerReceivablesAccount")

  @@unique([tenantId, legalEntityId, code])
  @@index([tenantId])
  @@index([legalEntityId])
  @@index([parentId])
}

model FiscalPeriod {
  id        String    @id @default(cuid())
  name      String
  startDate DateTime
  endDate   DateTime
  isClosed  Boolean   @default(false)
  closedAt  DateTime?
  closedBy  String?
  legalEntityId String
  tenantId  String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  // Relations
  tenant      Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  legalEntity LegalEntity   @relation(fields: [legalEntityId], references: [id], onDelete: Cascade)
  journalEntries JournalEntry[]

  @@unique([tenantId, legalEntityId, name])
  @@index([tenantId])
  @@index([legalEntityId])
}

model JournalEntry {
  id          String    @id @default(cuid())
  entryNumber String
  date        DateTime
  description String
  status      JournalEntryStatus @default(DRAFT)
  postedAt    DateTime?
  postedBy    String?
  periodId    String
  legalEntityId String
  originalEntryId String? @unique
  tenantId    String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  // Relations
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  period FiscalPeriod  @relation(fields: [periodId], references: [id])
  legalEntity LegalEntity @relation(fields: [legalEntityId], references: [id], onDelete: Cascade)
  originalEntry JournalEntry? @relation("JournalEntryReversal", fields: [originalEntryId], references: [id], onDelete: SetNull)
  reversalEntry JournalEntry? @relation("JournalEntryReversal")
  sourceTransfer IntercompanyTransfer? @relation("IntercompanySourceEntry")
  destinationTransfer IntercompanyTransfer? @relation("IntercompanyDestinationEntry")
  postedInvoice Invoice? @relation("InvoicePostedJournalEntry")
  lines  JournalLine[]

  @@unique([tenantId, legalEntityId, entryNumber])
  @@index([tenantId])
  @@index([tenantId, status])
  @@index([tenantId, legalEntityId, status])
  @@index([periodId])
  @@index([legalEntityId])
  @@index([originalEntryId])
}

model JournalLine {
  id             String    @id @default(cuid())
  journalEntryId String
  accountId      String
  debit          BigInt    @default(0)
  credit         BigInt    @default(0)
  transactionDebit  BigInt @default(0)
  transactionCredit BigInt @default(0)
  description    String?
  currency       String    @default("INR")
  fxRate         Decimal   @default(1)
  tenantId       String
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  // Relations
  tenant       Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  journalEntry JournalEntry @relation(fields: [journalEntryId], references: [id], onDelete: Cascade)
  account      Account      @relation(fields: [accountId], references: [id])

  @@index([tenantId])
  @@index([journalEntryId])
  @@index([accountId])
}

model IntercompanyTransfer {
  id                     String    @id @default(cuid())
  transferNumber         String
  description            String?
  transactionDate        DateTime
  currency               String
  sourceLegalEntityId    String
  destinationLegalEntityId String
  sourceEntryId          String    @unique
  destinationEntryId     String    @unique
  totalAmount            BigInt
  tenantId               String
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt
  deletedAt              DateTime?

  tenant                 Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sourceLegalEntity      LegalEntity  @relation("IntercompanyFromEntity", fields: [sourceLegalEntityId], references: [id], onDelete: Cascade)
  destinationLegalEntity LegalEntity  @relation("IntercompanyToEntity", fields: [destinationLegalEntityId], references: [id], onDelete: Cascade)
  sourceEntry            JournalEntry @relation("IntercompanySourceEntry", fields: [sourceEntryId], references: [id], onDelete: Cascade)
  destinationEntry       JournalEntry @relation("IntercompanyDestinationEntry", fields: [destinationEntryId], references: [id], onDelete: Cascade)

  @@unique([tenantId, transferNumber])
  @@index([tenantId])
  @@index([sourceLegalEntityId])
  @@index([destinationLegalEntityId])
}

model FxRate {
  id             String    @id @default(cuid())
  baseCurrency   String
  targetCurrency String
  rate           Decimal
  effectiveDate  DateTime
  source         String    @default("openexchangerates")
  tenantId       String
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  @@unique([tenantId, baseCurrency, targetCurrency, effectiveDate])
  @@index([tenantId])
}

// =============================================================================
// Section 4 — Accounts Payable / Accounts Receivable
// =============================================================================

model Invoice {
  id            String    @id @default(cuid())
  invoiceNumber String
  legalEntityId String
  vendorId      String?
  customerId    String?
  purchaseOrderId String?
  type          String    @default("PAYABLE")
  status        String    @default("OCR_PENDING")
  issueDate     DateTime
  totalAmount   BigInt
  taxAmount     BigInt    @default(0)
  currency      String    @default("INR")
  dueDate       DateTime
  poNumber      String?
  paidAt        DateTime?
  sourceDocumentKey String
  sourceDocumentMimeType String
  ocrStatus     String    @default("QUEUED")
  ocrProvider   String?
  reviewReason  String?
  counterpartyName String
  postedJournalEntryId String? @unique
  ocrData       Json?
  tenantId      String
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?

  // Relations
  legalEntity   LegalEntity    @relation(fields: [legalEntityId], references: [id], onDelete: Cascade)
  vendor        Vendor?        @relation(fields: [vendorId], references: [id], onDelete: SetNull)
  customer      Customer?      @relation(fields: [customerId], references: [id], onDelete: SetNull)
  purchaseOrder PurchaseOrder? @relation(fields: [purchaseOrderId], references: [id], onDelete: SetNull)
  postedJournalEntry JournalEntry? @relation("InvoicePostedJournalEntry", fields: [postedJournalEntryId], references: [id], onDelete: SetNull)
  lines         InvoiceLine[]
  threeWayMatch ThreeWayMatch?

  @@unique([tenantId, invoiceNumber])
  @@index([tenantId])
  @@index([tenantId, type, status])
  @@index([legalEntityId])
  @@index([vendorId])
  @@index([customerId])
  @@index([purchaseOrderId])
  @@index([postedJournalEntryId])
}

model InvoiceLine {
  id          String    @id @default(cuid())
  invoiceId   String
  description String
  quantity    Decimal
  unitPrice   BigInt
  amount      BigInt
  taxRate     Decimal   @default(0)
  tenantId    String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  // Relations
  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([invoiceId])
}

model ThreeWayMatch {
  id                 String    @id @default(cuid())
  invoiceId          String    @unique
  purchaseOrderId    String
  goodsReceiptId     String
  matchStatus        String    @default("PENDING")
  amountMatch        Boolean   @default(false)
  quantityMatch      Boolean   @default(false)
  lineItemSimilarity Decimal?
  variancePercent    Decimal?
  mismatchReasons    Json?
  matchedAt          DateTime?
  reviewedAt         DateTime?
  reviewedBy         String?
  tenantId           String
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  deletedAt          DateTime?

  // Relations
  invoice       Invoice       @relation(fields: [invoiceId], references: [id])
  purchaseOrder PurchaseOrder @relation(fields: [purchaseOrderId], references: [id])
  goodsReceipt  GoodsReceipt  @relation(fields: [goodsReceiptId], references: [id])

  @@index([tenantId])
  @@index([tenantId, matchStatus])
  @@index([purchaseOrderId])
  @@index([goodsReceiptId])
}

// =============================================================================
// Section 5 — HR Models
// =============================================================================

model Employee {
  id              String    @id @default(cuid())
  employeeCode    String
  userId          String?
  firstName       String
  lastName        String
  email           String
  phone           String?
  dateOfBirth     DateTime?
  hireDate        DateTime
  terminationDate DateTime?
  status          String    @default("PRE_START")
  departmentId    String
  designationId   String?
  managerId       String?
  tenantId        String
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?

  // Self-relation for reporting hierarchy
  manager Employee?  @relation("EmployeeHierarchy", fields: [managerId], references: [id], onDelete: SetNull)
  reports Employee[] @relation("EmployeeHierarchy")

  // Relations
  department        Department     @relation(fields: [departmentId], references: [id])
  headedDepartment  Department?    @relation("DepartmentHead")
  leaveRequests     LeaveRequest[]
  leaveBalances     LeaveBalance[]
  attendances       Attendance[]
  salaryStructures  SalaryStructure[]
  payrollResults    PayrollResult[]
  payslips          Payslip[]
  managedProjects   Project[]       @relation("ProjectManager")
  tasks             Task[]

  @@unique([tenantId, employeeCode])
  @@index([tenantId])
  @@index([tenantId, status])
  @@index([departmentId])
  @@index([managerId])
}

model Department {
  id        String    @id @default(cuid())
  name      String
  code      String
  parentId  String?
  headId    String?   @unique
  tenantId  String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  // Self-relation for department hierarchy
  parent   Department?  @relation("DepartmentHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children Department[] @relation("DepartmentHierarchy")

  // Relations
  tenant    Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  head      Employee?  @relation("DepartmentHead", fields: [headId], references: [id], onDelete: SetNull)
  employees Employee[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@index([parentId])
  @@index([headId])
}

model LeaveType {
  id                String    @id @default(cuid())
  name              String
  code              String
  accrualRate       Decimal
  maxBalance        Decimal
  carryForwardLimit Decimal   @default(0)
  tenantId          String
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  deletedAt         DateTime?

  // Relations
  leaveRequests LeaveRequest[]
  leaveBalances LeaveBalance[]

  @@unique([tenantId, code])
  @@index([tenantId])
}

model LeaveRequest {
  id          String    @id @default(cuid())
  employeeId  String
  leaveTypeId String
  startDate   DateTime
  endDate     DateTime
  status      String    @default("DRAFT")
  reason      String?
  submittedAt DateTime?
  approvedBy  String?
  approvedAt  DateTime?
  rejectedAt  DateTime?
  cancelledAt DateTime?
  rejectionReason String?
  cancelReason String?
  systemReason String?
  tenantId    String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  // Relations
  employee  Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  leaveType LeaveType @relation(fields: [leaveTypeId], references: [id])

  @@index([tenantId])
  @@index([tenantId, status])
  @@index([employeeId])
  @@index([leaveTypeId])
}

model LeaveBalance {
  id          String    @id @default(cuid())
  employeeId  String
  leaveTypeId String
  balance     Decimal
  year        Int
  tenantId    String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  // Relations
  employee  Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  leaveType LeaveType @relation(fields: [leaveTypeId], references: [id])

  @@unique([tenantId, employeeId, leaveTypeId, year])
  @@index([tenantId])
}

model Attendance {
  id            String    @id @default(cuid())
  employeeId    String
  date          DateTime
  clockIn       DateTime?
  clockOut      DateTime?
  hoursWorked   Decimal?
  overtimeHours Decimal   @default(0)
  status        String    @default("PRESENT")
  correctedBy   String?
  correctedAt   DateTime?
  correctionReason String?
  tenantId      String
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?

  // Relations
  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([tenantId, employeeId, date])
  @@index([tenantId])
  @@index([employeeId])
}

// =============================================================================
// Section 6 — Payroll Models
// =============================================================================

model PayrollRun {
  id              String    @id @default(cuid())
  period          String
  periodStart     DateTime
  periodEnd       DateTime
  legalEntityId   String
  status          String    @default("DRAFT")
  processingStage String    @default("QUEUED")
  failureReason   String?
  attemptNumber   Int       @default(1)
  queuedAt        DateTime?
  totalGross      BigInt    @default(0)
  totalDeductions BigInt    @default(0)
  totalNet        BigInt    @default(0)
  processedCount  Int       @default(0)
  totalCount      Int       @default(0)
  startedAt       DateTime?
  completedAt     DateTime?
  glJournalEntryId String?
  compensationJournalEntryId String?
  tenantId        String
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?

  // Relations
  legalEntity    LegalEntity    @relation(fields: [legalEntityId], references: [id], onDelete: Cascade)
  payrollResults PayrollResult[]
  payslips       Payslip[]

  @@index([tenantId])
  @@index([tenantId, status])
  @@index([legalEntityId])
  @@index([tenantId, legalEntityId, periodStart, periodEnd])
  @@index([tenantId, processingStage])
  @@unique([tenantId, legalEntityId, periodStart, periodEnd, attemptNumber])
}

model Payslip {
  id           String    @id @default(cuid())
  payrollRunId String
  payrollResultId String? @unique
  employeeId   String
  grossPay     BigInt
  earnings     Json
  deductions   Json
  netPay       BigInt
  taxBreakdown Json
  pdfUrl       String?
  storageBucket String?
  storageKey   String?
  fileName     String?
  contentType  String?
  renderMetadata Json?
  renderedAt   DateTime?
  tenantId     String
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  // Relations
  payrollRun    PayrollRun     @relation(fields: [payrollRunId], references: [id], onDelete: Cascade)
  payrollResult PayrollResult? @relation(fields: [payrollResultId], references: [id], onDelete: SetNull)
  employee      Employee       @relation(fields: [employeeId], references: [id])

  @@index([tenantId])
  @@index([payrollRunId])
  @@index([employeeId])
}

model SalaryStructure {
  id                        String    @id @default(cuid())
  employeeId                String
  legalEntityId             String
  name                      String
  currency                  String    @default("INR")
  taxRegime                 String
  effectiveFrom             DateTime
  effectiveTo               DateTime?
  pfApplicable              Boolean   @default(true)
  professionalTaxApplicable Boolean   @default(true)
  overtimeEligible          Boolean   @default(true)
  tenantId                  String
  createdAt                 DateTime  @default(now())
  updatedAt                 DateTime  @updatedAt
  deletedAt                 DateTime?

  employee       Employee         @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  legalEntity    LegalEntity      @relation(fields: [legalEntityId], references: [id], onDelete: Cascade)
  components     SalaryComponent[]
  payrollResults PayrollResult[]

  @@index([tenantId])
  @@index([employeeId])
  @@index([legalEntityId])
  @@index([tenantId, employeeId, effectiveFrom, effectiveTo])
  @@unique([tenantId, employeeId, legalEntityId, effectiveFrom])
}

model SalaryComponent {
  id                        String    @id @default(cuid())
  salaryStructureId         String
  code                      String
  name                      String
  componentType             String
  amountMinor               BigInt
  calculationType           String    @default("FIXED")
  isRecurring               Boolean   @default(true)
  isTaxable                 Boolean   @default(true)
  pfApplicable              Boolean   @default(false)
  professionalTaxApplicable Boolean   @default(false)
  overtimeApplicable        Boolean   @default(false)
  sortOrder                 Int       @default(0)
  tenantId                  String
  createdAt                 DateTime  @default(now())
  updatedAt                 DateTime  @updatedAt
  deletedAt                 DateTime?

  salaryStructure SalaryStructure @relation(fields: [salaryStructureId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([salaryStructureId])
  @@index([tenantId, componentType])
  @@unique([salaryStructureId, code])
}

model PayrollResult {
  id                String    @id @default(cuid())
  payrollRunId      String
  employeeId        String
  salaryStructureId String?
  status            String    @default("PENDING")
  processingStage   String    @default("SNAPSHOT_CREATED")
  grossPay          BigInt    @default(0)
  totalDeductions   BigInt    @default(0)
  netPay            BigInt    @default(0)
  earnings          Json
  deductions        Json
  taxBreakdown      Json
  payableDays       Decimal   @default(0)
  lossOfPay         BigInt    @default(0)
  overtime          BigInt    @default(0)
  overtimeHours     Decimal   @default(0)
  workingDays       Int       @default(0)
  presentDays       Decimal   @default(0)
  leaveDays         Decimal   @default(0)
  inputSnapshot     Json?
  failureReason     String?
  processedAt       DateTime?
  tenantId          String
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  deletedAt         DateTime?

  payrollRun      PayrollRun       @relation(fields: [payrollRunId], references: [id], onDelete: Cascade)
  employee        Employee         @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  salaryStructure SalaryStructure? @relation(fields: [salaryStructureId], references: [id], onDelete: SetNull)
  payslip         Payslip?

  @@index([tenantId])
  @@index([employeeId])
  @@index([payrollRunId])
  @@index([tenantId, status])
  @@index([tenantId, processingStage])
  @@unique([tenantId, payrollRunId, employeeId])
}

model TaxSlab {
  id            String    @id @default(cuid())
  jurisdiction  String    @default("IN")
  regime        String
  minIncome     BigInt
  maxIncome     BigInt?
  rate          Decimal
  rebateLimit   BigInt?
  effectiveFrom DateTime
  effectiveTo   DateTime?
  tenantId      String
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?

  @@index([tenantId])
  @@index([jurisdiction, regime])
}

// =============================================================================
// Section 7 — Supply Chain Models
// =============================================================================

model Customer {
  id                   String    @id @default(cuid())
  name                 String
  code                 String
  email                String?
  phone                String?
  address              String?
  paymentTerms         Int       @default(30)
  currency             String    @default("INR")
  status               String    @default("ACTIVE")
  legalEntityId        String
  receivablesAccountId String?
  tenantId             String
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  deletedAt            DateTime?

  // Relations
  legalEntity         LegalEntity @relation(fields: [legalEntityId], references: [id], onDelete: Cascade)
  receivablesAccount  Account?    @relation("CustomerReceivablesAccount", fields: [receivablesAccountId], references: [id], onDelete: SetNull)
  invoices            Invoice[]

  @@unique([tenantId, legalEntityId, code])
  @@index([tenantId])
  @@index([legalEntityId])
  @@index([receivablesAccountId])
  @@index([tenantId, status])
}

model Vendor {
  id           String    @id @default(cuid())
  name         String
  code         String
  email        String?
  phone        String?
  address      String?
  paymentTerms Int       @default(30)
  currency     String    @default("INR")
  status       String    @default("ACTIVE")
  legalEntityId String
  payablesAccountId String?
  tenantId     String
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  // Relations
  legalEntity     LegalEntity      @relation(fields: [legalEntityId], references: [id], onDelete: Cascade)
  payablesAccount Account?         @relation("VendorPayablesAccount", fields: [payablesAccountId], references: [id], onDelete: SetNull)
  purchaseOrders PurchaseOrder[]
  invoices       Invoice[]
  replenishmentSettings ProductReplenishmentSetting[]

  @@unique([tenantId, legalEntityId, code])
  @@index([tenantId])
  @@index([legalEntityId])
  @@index([payablesAccountId])
  @@index([tenantId, status])
}

model PurchaseOrder {
  id               String    @id @default(cuid())
  poNumber         String
  vendorId         String
  legalEntityId    String
  status           String    @default("DRAFT")
  totalAmount      BigInt    @default(0)
  currency         String    @default("INR")
  expectedDelivery DateTime?
  submittedAt      DateTime?
  approvedBy       String?
  approvedAt       DateTime?
  rejectedAt       DateTime?
  rejectedReason   String?
  sentToVendorAt   DateTime?
  closedAt         DateTime?
  tenantId         String
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  deletedAt        DateTime?

  // Relations
  vendor        Vendor              @relation(fields: [vendorId], references: [id])
  legalEntity   LegalEntity         @relation(fields: [legalEntityId], references: [id], onDelete: Cascade)
  lines         PurchaseOrderLine[]
  goodsReceipts GoodsReceipt[]
  inventoryMovements InventoryMovement[]
  threeWayMatch ThreeWayMatch[]
  invoices      Invoice[]

  @@unique([tenantId, poNumber])
  @@index([tenantId])
  @@index([tenantId, status])
  @@index([vendorId])
  @@index([legalEntityId])
}

model PurchaseOrderLine {
  id               String    @id @default(cuid())
  purchaseOrderId  String
  productId        String
  description      String
  quantity         Decimal
  unitPrice        BigInt
  receivedQuantity Decimal   @default(0)
  tenantId         String
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  deletedAt        DateTime?

  // Relations
  purchaseOrder     PurchaseOrder      @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  product           Product            @relation(fields: [productId], references: [id])
  goodsReceiptLines GoodsReceiptLine[]

  @@index([tenantId])
  @@index([purchaseOrderId])
  @@index([productId])
}

model Product {
  id            String    @id @default(cuid())
  sku           String
  name          String
  description   String?
  category      String?
  unitOfMeasure String    @default("PCS")
  reorderPoint  Decimal   @default(0)
  tenantId      String
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?

  // Relations
  purchaseOrderLines  PurchaseOrderLine[]
  replenishmentSettings ProductReplenishmentSetting[]
  inventoryItems      InventoryItem[]
  costLayers          CostLayer[]
  inventoryMovements  InventoryMovement[]
  forecastPredictions ForecastPrediction[]
  forecastModels      ForecastModel[]

  @@unique([tenantId, sku])
  @@index([tenantId])
}

model InventoryItem {
  id               String    @id @default(cuid())
  productId        String
  warehouseId      String
  quantity         Decimal   @default(0)
  reservedQuantity Decimal   @default(0)
  tenantId         String
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  deletedAt        DateTime?

  // Relations
  product   Product   @relation(fields: [productId], references: [id])
  warehouse Warehouse @relation(fields: [warehouseId], references: [id])

  @@unique([tenantId, productId, warehouseId])
  @@index([tenantId])
  @@index([productId])
  @@index([warehouseId])
  @@index([tenantId, productId, warehouseId])
}

model Warehouse {
  id        String    @id @default(cuid())
  name      String
  code      String
  address   String?
  tenantId  String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  // Relations
  inventoryItems      InventoryItem[]
  costLayers          CostLayer[]
  goodsReceipts       GoodsReceipt[]
  inventoryMovements InventoryMovement[]
  forecastPredictions ForecastPrediction[]

  @@unique([tenantId, code])
  @@index([tenantId])
}

model CostLayer {
  id                String    @id @default(cuid())
  productId         String
  warehouseId       String
  quantity          Decimal
  unitCost          BigInt
  remainingQuantity Decimal
  receivedAt        DateTime  @default(now())
  tenantId          String
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  deletedAt         DateTime?

  // Relations
  product   Product   @relation(fields: [productId], references: [id])
  warehouse Warehouse @relation(fields: [warehouseId], references: [id])
  inventoryMovements InventoryMovement[]

  @@index([tenantId])
  @@index([productId])
  @@index([warehouseId])
  @@index([tenantId, productId, warehouseId, receivedAt])
}

model GoodsReceipt {
  id              String    @id @default(cuid())
  purchaseOrderId String
  legalEntityId   String
  warehouseId     String
  receivedDate    DateTime  @default(now())
  receivedBy      String
  tenantId        String
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?

  // Relations
  purchaseOrder PurchaseOrder      @relation(fields: [purchaseOrderId], references: [id])
  legalEntity   LegalEntity        @relation(fields: [legalEntityId], references: [id], onDelete: Cascade)
  warehouse     Warehouse          @relation(fields: [warehouseId], references: [id])
  lines         GoodsReceiptLine[]
  inventoryMovements InventoryMovement[]
  threeWayMatch ThreeWayMatch[]

  @@index([tenantId])
  @@index([purchaseOrderId])
  @@index([legalEntityId])
  @@index([warehouseId])
}

model GoodsReceiptLine {
  id                  String    @id @default(cuid())
  goodsReceiptId      String
  purchaseOrderLineId String
  quantityReceived    Decimal
  tenantId            String
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  deletedAt           DateTime?

  // Relations
  goodsReceipt      GoodsReceipt      @relation(fields: [goodsReceiptId], references: [id], onDelete: Cascade)
  purchaseOrderLine PurchaseOrderLine @relation(fields: [purchaseOrderLineId], references: [id])

  @@index([tenantId])
  @@index([goodsReceiptId])
  @@index([purchaseOrderLineId])
}

model ProductReplenishmentSetting {
  id                   String    @id @default(cuid())
  productId            String
  legalEntityId        String
  vendorId             String
  reorderQuantity      Decimal
  isAutoReorderEnabled Boolean   @default(true)
  tenantId             String
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  deletedAt            DateTime?

  // Relations
  product     Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  legalEntity LegalEntity @relation(fields: [legalEntityId], references: [id], onDelete: Cascade)
  vendor      Vendor      @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@unique([tenantId, productId, legalEntityId])
  @@index([tenantId])
  @@index([productId])
  @@index([vendorId])
  @@index([legalEntityId])
  @@index([tenantId, productId, isAutoReorderEnabled])
}

model InventoryMovement {
  id              String    @id @default(cuid())
  movementType    String
  productId       String
  warehouseId     String
  legalEntityId   String?
  costLayerId     String?
  goodsReceiptId  String?
  purchaseOrderId String?
  quantity        Decimal
  unitCost        BigInt?
  referenceType   String?
  referenceId     String?
  notes           String?
  performedBy     String?
  movedAt         DateTime  @default(now())
  tenantId        String
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?

  // Relations
  product       Product       @relation(fields: [productId], references: [id])
  warehouse     Warehouse     @relation(fields: [warehouseId], references: [id])
  legalEntity   LegalEntity?  @relation(fields: [legalEntityId], references: [id], onDelete: SetNull)
  costLayer     CostLayer?    @relation(fields: [costLayerId], references: [id], onDelete: SetNull)
  goodsReceipt  GoodsReceipt? @relation(fields: [goodsReceiptId], references: [id], onDelete: SetNull)
  purchaseOrder PurchaseOrder? @relation(fields: [purchaseOrderId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([productId])
  @@index([warehouseId])
  @@index([legalEntityId])
  @@index([costLayerId])
  @@index([goodsReceiptId])
  @@index([purchaseOrderId])
  @@index([tenantId, productId, warehouseId, movedAt])
}

// =============================================================================
// Section 8 — Project Management Models
// =============================================================================

model Project {
  id          String    @id @default(cuid())
  code        String
  name        String
  description String?
  managerId   String
  budget      BigInt    @default(0)
  actualCost  BigInt    @default(0)
  status      String    @default("PLANNING")
  startDate   DateTime?
  endDate     DateTime?
  tenantId    String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  // Relations
  manager    Employee           @relation("ProjectManager", fields: [managerId], references: [id])
  tasks      Task[]
  milestones ProjectMilestone[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@index([tenantId, status])
  @@index([managerId])
}

model Task {
  id             String    @id @default(cuid())
  projectId      String
  milestoneId    String?
  name           String
  description    String?
  assigneeId     String?
  status         String    @default("TODO")
  priority       String    @default("MEDIUM")
  estimatedHours Decimal?
  actualHours    Decimal   @default(0)
  startDate      DateTime?
  dueDate        DateTime?
  completedAt    DateTime?
  tenantId       String
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  // Relations
  project      Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  milestone    ProjectMilestone? @relation(fields: [milestoneId], references: [id], onDelete: SetNull)
  assignee     Employee?        @relation(fields: [assigneeId], references: [id], onDelete: SetNull)
  dependencies TaskDependency[] @relation("DependentTask")
  dependents   TaskDependency[] @relation("DependsOnTask")

  @@index([tenantId])
  @@index([tenantId, status])
  @@index([projectId])
  @@index([milestoneId])
  @@index([assigneeId])
}

model TaskDependency {
  id              String    @id @default(cuid())
  taskId          String
  dependsOnTaskId String
  type            String    @default("FINISH_TO_START")
  tenantId        String
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?

  // Relations
  task      Task @relation("DependentTask", fields: [taskId], references: [id], onDelete: Cascade)
  dependsOn Task @relation("DependsOnTask", fields: [dependsOnTaskId], references: [id], onDelete: Cascade)

  @@unique([taskId, dependsOnTaskId])
  @@index([tenantId])
}

model ProjectMilestone {
  id          String    @id @default(cuid())
  projectId   String
  name        String
  dueDate     DateTime
  status      String    @default("PENDING")
  completedAt DateTime?
  tenantId    String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  // Relations
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tasks   Task[]

  @@index([tenantId])
  @@index([projectId])
}

// =============================================================================
// Section 9 — ML / Forecast Models
// =============================================================================

model ForecastPrediction {
  id              String    @id @default(cuid())
  forecastDate    DateTime
  productId       String
  warehouseId     String?
  predictedDemand Decimal
  confidenceLower Decimal?
  confidenceUpper Decimal?
  modelType       String
  modelVersion    String?
  mape            Decimal?
  forecastModelId String?
  generatedAt     DateTime  @default(now())
  horizonDay      Int?
  tenantId        String
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?

  // Relations
  product       Product        @relation(fields: [productId], references: [id])
  warehouse     Warehouse?     @relation(fields: [warehouseId], references: [id])
  forecastModel ForecastModel? @relation(fields: [forecastModelId], references: [id])

  @@index([tenantId])
  @@index([tenantId, forecastDate])
  @@index([productId])
  @@index([warehouseId])
  @@index([forecastModelId])
  @@index([tenantId, productId, forecastDate])
}

model ForecastModel {
  id                  String    @id @default(cuid())
  productId           String
  modelType           String
  version             String
  mape                Decimal
  trainedAt           DateTime
  trainingWindowStart DateTime?
  trainingWindowEnd   DateTime?
  dataPoints          Int?
  artifactUri         String?
  promotedAt          DateTime?
  isActive            Boolean   @default(false)
  hyperparameters     Json?
  metrics             Json?
  tenantId            String
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  deletedAt           DateTime?

  // Relations
  product     Product              @relation(fields: [productId], references: [id])
  predictions ForecastPrediction[]

  @@index([tenantId])
  @@index([productId])
  @@index([tenantId, productId, isActive])
  @@index([productId, modelType])
  @@index([tenantId, productId, modelType, trainedAt])
}

// =============================================================================
// Section 10 — BI / Dashboard Models
// =============================================================================

model Dashboard {
  id        String    @id @default(cuid())
  title     String
  description String?
  ownerId   String
  isPublic  Boolean   @default(false)
  layout    Json?
  defaultFilters Json?
  tenantId  String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  // Relations
  owner          User             @relation(fields: [ownerId], references: [id])
  widgets        Widget[]
  reportSchedules ReportSchedule[]
  reportRuns     ReportRun[]

  @@index([tenantId])
  @@index([ownerId])
  @@index([tenantId, ownerId, deletedAt])
  @@index([tenantId, isPublic, deletedAt])
}

model Widget {
  id          String     @id @default(cuid())
  dashboardId String
  type        WidgetType
  title       String
  metricKey   String
  config      Json?
  position    Json
  refreshEnabled Boolean @default(true)
  sortOrder   Int        @default(0)
  tenantId    String
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  deletedAt   DateTime?

  // Relations
  dashboard Dashboard @relation(fields: [dashboardId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([dashboardId])
  @@index([dashboardId, sortOrder])
}

model ReportSchedule {
  id             String    @id @default(cuid())
  dashboardId    String
  title          String
  cronExpression String
  timezone       String    @default("UTC")
  recipients     Json
  formats        String[]
  isEnabled      Boolean   @default(true)
  lastRunAt      DateTime?
  nextRunAt      DateTime?
  createdById    String?
  tenantId       String
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  dashboard Dashboard   @relation(fields: [dashboardId], references: [id], onDelete: Cascade)
  runs      ReportRun[]

  @@index([tenantId])
  @@index([dashboardId])
  @@index([tenantId, isEnabled, deletedAt])
}

model ReportRun {
  id               String    @id @default(cuid())
  reportScheduleId String?
  dashboardId      String
  status           String    @default("PENDING")
  startedAt        DateTime?
  completedAt      DateTime?
  snapshot         Json?
  artifact         Json?
  deliveryStatus   String    @default("PENDING")
  failureReason    String?
  triggeredBy      String?
  tenantId         String
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  deletedAt        DateTime?

  reportSchedule ReportSchedule? @relation(fields: [reportScheduleId], references: [id], onDelete: SetNull)
  dashboard      Dashboard       @relation(fields: [dashboardId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([dashboardId])
  @@index([reportScheduleId])
  @@index([tenantId, status, createdAt])
}

// =============================================================================
// Section 11 — Notification Models
// =============================================================================

model Notification {
  id        String              @id @default(cuid())
  userId    String
  type      String
  channel   NotificationChannel
  title     String
  body      String?
  isRead    Boolean             @default(false)
  readAt    DateTime?
  metadata  Json?
  tenantId  String
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt
  deletedAt DateTime?

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([userId])
  @@index([userId, isRead])
}

model OutboxEvent {
  id          String    @id @default(cuid())
  eventType   String
  payload     Json
  status      String    @default("PENDING")
  processedAt DateTime?
  retryCount  Int       @default(0)
  nextAttemptAt DateTime?
  processingStartedAt DateTime?
  lastError   String?
  deliveryState Json?
  tenantId    String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  @@index([status, createdAt])
  @@index([status, nextAttemptAt])
  @@index([tenantId])
}

model NotificationPreference {
  id        String              @id @default(cuid())
  userId    String
  eventType String
  channel   NotificationChannel
  enabled   Boolean             @default(true)
  tenantId  String
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt
  deletedAt DateTime?

  @@unique([tenantId, userId, eventType, channel])
  @@index([tenantId])
}

model WebhookConfig {
  id        String    @id @default(cuid())
  url       String
  secret    String
  events    String[]
  isActive  Boolean   @default(true)
  tenantId  String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([tenantId])
}

model NotificationTemplate {
  id        String              @id @default(cuid())
  eventType String
  channel   NotificationChannel
  subject   String?
  body      String
  tenantId  String
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt
  deletedAt DateTime?

  @@unique([tenantId, eventType, channel])
  @@index([tenantId])
}
