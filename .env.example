# .env.example
# Amdox ERP Environment Configuration

# -----------------------------------------------------------------------------
# Database Configuration
# -----------------------------------------------------------------------------
# PostgreSQL (TimescaleDB) connection string.
# Format: postgresql://<user>:<password>@<host>:<port>/<db_name>
DATABASE_URL="postgresql://root:rootpassword@localhost:5432/amdox_erp"

# -----------------------------------------------------------------------------
# Redis Configuration
# -----------------------------------------------------------------------------
# Redis connection URL for caching and BullMQ.
# Format: redis://<host>:<port>
REDIS_URL="redis://localhost:6379"

# -----------------------------------------------------------------------------
# Keycloak Auth Configuration
# -----------------------------------------------------------------------------
# Base URL for Keycloak SSO server
KEYCLOAK_URL="http://localhost:8080"
# Admin bootstrap credentials (used in docker-compose.yml, not needed directly by backend usually)
KC_BOOTSTRAP_ADMIN_USERNAME=admin
KC_BOOTSTRAP_ADMIN_PASSWORD=adminpassword
# Keycloak Client configuration for backend and frontend
KEYCLOAK_CLIENT_ID="amdox-api"
KEYCLOAK_CLIENT_SECRET="your_client_secret_here" # Retrieve from Keycloak Admin Dashboard

# -----------------------------------------------------------------------------
# Elasticsearch Configuration
# -----------------------------------------------------------------------------
# Point to Elasticsearch Node
ELASTICSEARCH_NODE="http://localhost:9200"

# -----------------------------------------------------------------------------
# SMTP/Mailpit Configuration
# -----------------------------------------------------------------------------
# Mailpit SMTP relay host and port configuration
SMTP_HOST="localhost"
SMTP_PORT=1025
