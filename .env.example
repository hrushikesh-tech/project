# .env.example
# Amdox ERP Environment Configuration

# -----------------------------------------------------------------------------
# Environment & Ports
# -----------------------------------------------------------------------------
NODE_ENV="development"
PORT_WEB=3000
PORT_API=3001
PORT_ML=8000
LOG_LEVEL="debug"

# -----------------------------------------------------------------------------
# Inter-Service URLs
# -----------------------------------------------------------------------------
NEXT_PUBLIC_API_URL="http://localhost:3001/api/v1"
ML_SERVICE_URL="http://localhost:8000"

# -----------------------------------------------------------------------------
# Database Configuration
# -----------------------------------------------------------------------------
# PostgreSQL (TimescaleDB) connection string.
DATABASE_URL="postgresql://root:rootpassword@localhost:5432/amdox_erp"

# -----------------------------------------------------------------------------
# Redis Configuration
# -----------------------------------------------------------------------------
# Redis connection URL for caching and BullMQ.
REDIS_URL="redis://localhost:6379"

# -----------------------------------------------------------------------------
# Keycloak Auth Configuration
# -----------------------------------------------------------------------------
# Base URL for Keycloak SSO server
KEYCLOAK_URL="http://localhost:8080"
KEYCLOAK_REALM="amdox-erp"
# Admin bootstrap credentials
KC_BOOTSTRAP_ADMIN_USERNAME=admin
KC_BOOTSTRAP_ADMIN_PASSWORD=adminpassword
# Keycloak Client configuration
KEYCLOAK_CLIENT_ID="amdox-api"
KEYCLOAK_CLIENT_SECRET="your_client_secret_here"

# -----------------------------------------------------------------------------
# FX Provider Configuration
# -----------------------------------------------------------------------------
# Required for live FX fetches when a rate is not already present in Redis/DB.
OPENEXCHANGE_APP_ID="your_open_exchange_rates_app_id_here"
OPENEXCHANGE_BASE_CURRENCIES="USD"
OPENEXCHANGE_TARGET_CURRENCIES="INR,USD,EUR"

# -----------------------------------------------------------------------------
# Elasticsearch Configuration
# -----------------------------------------------------------------------------
ELASTICSEARCH_NODE="http://localhost:9200"

# -----------------------------------------------------------------------------
# SMTP/Mailpit Configuration
# -----------------------------------------------------------------------------
SMTP_HOST="localhost"
SMTP_PORT=1025

# -----------------------------------------------------------------------------
# Observability (OpenTelemetry)
# -----------------------------------------------------------------------------
OTEL_EXPORTER_OTLP_ENDPOINT="http://localhost:4317"
OTEL_SERVICE_NAME="amdox-backend"

# -----------------------------------------------------------------------------
# AWS Storage (S3 Placeholder)
# -----------------------------------------------------------------------------
AWS_REGION="us-east-1"
AWS_S3_BUCKET="amdox-erp-assets-dev"
AWS_ACCESS_KEY_ID="testing"
AWS_SECRET_ACCESS_KEY="testing"
AWS_S3_ENDPOINT=""
AWS_S3_FORCE_PATH_STYLE="false"
PUPPETEER_EXECUTABLE_PATH=""
CHROME_BIN=""
